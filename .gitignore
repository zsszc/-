.venv/
__pycache__/
*.pyc
.env
.DS_Store
# .env 的各种变体(备份、按环境分的副本)同样含真实密钥,必须一起挡住。
# 只放行 .env.example —— 它是对外发布的模板,里面只有占位符。
.env.*
!.env.example

# 在线 Agent 评测报告含完整模型回答与工具结果，仅保留在本地，避免外发内部知识内容。
data/evals/logistics_agent_eval_report_live*.json
data/evals/logistics_agent_eval_report_live*.json.tmp
data/evals/logistics_retrieval_eval_report.json
# 观测、成本与阈值校准会在本机持续重跑；不把运行产物纳入 Git。
data/ch09/reports/
.pytest_cache/
.superpowers/
data/*.db*
data/*.sqlite*
dev-notes/
docs/superpowers/
log/
logs/
*.pid
data/ch10/*
!data/ch10/reports
tmp-ctx-probe.*
tmp-lesson*.txt

# 运行日志:后台页发起的作业与 dev.sh 启动日志,本地产物不入库
data/*.log
data/ch04/*.log
