[Unit]
Description=MewHelp Cross-border Logistics Agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mewhelp
Environment=PYTHONUTF8=1
EnvironmentFile=/opt/mewhelp/.env
ExecStart=/opt/mewhelp/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
